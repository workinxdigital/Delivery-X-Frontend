# DeliverX web — environment
# Copy to .env.local and fill in. NEVER commit real values (CLAUDE.md §4.7).
#
# NOTE: there is deliberately no DATABASE_URL here. The web app does not
# connect to Postgres. All data access goes through the API.
# ---------------------------------------------------------------------------

# Base URL of the Express API, including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
